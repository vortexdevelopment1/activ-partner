# Application
APP_PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=activ_product_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRY=30d

# File Upload
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880

# Payment (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# MSG91 (email + SMS OTP)
MSG91_AUTHKEY=your_msg91_authkey
MSG91_FROM_EMAIL=no-reply@{YOUR_REGISTERED_DOMAIN}
MSG91_DOMAIN={YOUR_REGISTERED_DOMAIN}
# false = mock OTP (last 4 digits of phone, no SMS sent) — good for local dev
MSG91_OTP_ENABLED=false
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id

# OneSignal (push notifications)
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# Admin Default Credentials
ADMIN_EMAIL=admin@activproduct.com
ADMIN_PASSWORD=Admin@123
