# Application
APP_PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000

# Database
# Transaction-mode pooler used by Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:6543/activ_product_db?pgbouncer=true

# Session-mode connection used by TypeORM, Prisma CLI, and migrations.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/activ_product_db

# Legacy DB_* values are still accepted and are used to build DATABASE_URL
# when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=activ_product_db
DB_SSL=false
DB_LOGGING=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRY=30d

# File Upload
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880

# Payment (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# MSG91 (email + SMS OTP)
MSG91_AUTHKEY=your_msg91_authkey
MSG91_FROM_EMAIL=no-reply@{YOUR_REGISTERED_DOMAIN}
MSG91_DOMAIN={YOUR_REGISTERED_DOMAIN}
# Existing approval/welcome email template. Keep the current MSG91 template ID
# unless a new template is created in the MSG91 dashboard.
MSG91_APPROVAL_TEMPLATE_ID=partnerapprovaltemplate
# false = mock OTP (last 4 digits of phone, no SMS sent) — good for local dev
MSG91_OTP_ENABLED=false
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id
# DLT-approved MSG91 Flow template used when a partner invites a team member.
MSG91_TEAM_INVITE_TEMPLATE_ID=your_team_invite_template_id
# Signed agreement email. The Google Workspace account must be authorized to send as support@activ.live.
MAIL_FROM_EMAIL=support@activ.live
# SMTP account must be authorized
# to send as support@activ.live). Port 465 uses TLS; 587 uses STARTTLS.
# For Gmail use the full mailbox address and a Google app password (not the
# regular account password). Verify without sending: node scripts/verify-mail.cjs
# Restart the backend after changing these credentials.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# MSG91 changes-request email template variables: venueName, reason, instructions.
# Set this to an approved changes-request template; do not reuse a rejection template.
MSG91_VENUE_CHANGES_TEMPLATE_ID=
# Gmail OAuth 2.0 setup and Gmail API sender
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=jangidlucky444@gmail.com
GOOGLE_OAUTH_SETUP_ENABLED=false
# Strong random value, at least 32 characters. Never commit it.
GOOGLE_OAUTH_SETUP_KEY=
# Optional encrypted local/server-side token storage. Keep this key in secrets.
GOOGLE_REFRESH_TOKEN_STORAGE_KEY=
GOOGLE_REFRESH_TOKEN_FILE=./.secrets/google-refresh-token.enc

# OneSignal (push notifications)
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# Admin Default Credentials
ADMIN_EMAIL=admin@activproduct.com
ADMIN_PASSWORD=Admin@123

# Development partner seed credentials
PARTNER_EMAIL=partner@activ.com
PARTNER_PASSWORD=Partner@123
PARTNER_PHONE_E164=+919999999999
PARTNER_BUSINESS_NAME=Activ Demo Partner
